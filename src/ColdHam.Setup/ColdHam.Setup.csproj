<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ColdHam.Setup</AssemblyName>
    <Version>1.0.3</Version>
    <ApplicationIcon>../ColdHam.App/Assets/ColdHam.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ColdHam.Core/ColdHam.Core.csproj" />
    <Resource Include="../ColdHam.App/Assets/ColdHam.ico" Link="Assets/ColdHam.ico" />
    <EmbeddedResource Include="$(SetupPayloadPath)" LogicalName="ColdHam.Setup.Payload.exe" Condition="'$(SetupPayloadPath)' != ''" />
  </ItemGroup>
  <Target Name="RequireSetupPayload" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(SetupPayloadPath)' == '' Or !Exists('$(SetupPayloadPath)')" Text="Publish setup through scripts/Build-Release.ps1 with a valid SetupPayloadPath." />
  </Target>
</Project>
