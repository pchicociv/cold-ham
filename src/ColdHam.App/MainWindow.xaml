<Window x:Class="ColdHam.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cold Ham" Height="740" Width="960" MinHeight="640" MinWidth="800"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,17">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="COLD HAM" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#98A2B3" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusTitleText" Text="Cargando…" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Margin="19,3,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="NextChangeText" Margin="19,2,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="EnforcementText" Margin="19,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="Start25Button" Content="25 min" Style="{StaticResource PrimaryButton}" Click="Start25Button_Click" />
                    <Button x:Name="Start50Button" Content="50 min" Style="{StaticResource PrimaryButton}" Click="Start50Button_Click" />
                    <TextBox x:Name="SessionMinutesInput" Width="54" Margin="4,0" ToolTip="Minutos: entre 1 y 1440" />
                    <Button x:Name="StartCustomButton" Content="Iniciar" Style="{StaticResource PrimaryButton}" Click="StartCustomButton_Click" />
                    <Button x:Name="StartButton" Content="Sin límite" Click="StartButton_Click" />
                    <Button x:Name="EndSessionButton" Content="Terminar sesión" Click="EndSessionButton_Click" />
                    <Button x:Name="StopButton" Content="Detener todo" Style="{StaticResource DangerButton}" Click="StopButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="AdminBanner" Grid.Row="1" Visibility="Collapsed" Background="#FFFAEB"
                BorderBrush="#FEC84B" BorderThickness="0,0,0,1" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Revisión necesaria" FontWeight="SemiBold" />
                    <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="RecoveryText" Text=""
                                   Foreground="#7A5A10" Margin="0,2,16,0" TextWrapping="Wrap" />
                    </ScrollViewer>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="Reintentar" Click="RetryButton_Click" />
                    <Button Content="Reiniciar como administrador" Click="ElevateButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" x:Name="MainTabs" Margin="20,16,20,0">
            <TabItem Header="Resumen">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Configuración actual" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="SummaryText" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="SessionSummaryText" Margin="0,7,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Programación" FontWeight="SemiBold" />
                            <TextBlock x:Name="OverviewScheduleText" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Funcionamiento" FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap">
                                Mantén Cold Ham abierto para bloquear aplicaciones. Las reglas web permanecen en el archivo hosts hasta detener el bloqueo.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Sitios web">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Sitios bloqueados" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Añade un dominio o pega una dirección web." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="WebsiteCountText" Grid.Column="1" VerticalAlignment="Bottom" Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,18,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WebsiteInput" KeyDown="WebsiteInput_KeyDown" ToolTip="Ejemplo: reddit.com" />
                        <Button Grid.Column="1" Content="Añadir" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="AddWebsiteButton_Click" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="WebsiteList" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Value}" FontWeight="SemiBold" />
                                                <TextBlock Text="Dominio y variante www" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" Margin="20,0" />
                                            <Button Grid.Column="2" Style="{StaticResource InlineDeleteButton}" Click="RemoveWebsiteItem_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="WebsiteEmptyText" Text="Aún no has añadido sitios web." Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Aplicaciones">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Aplicaciones bloqueadas" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Selecciona un ejecutable o escribe su nombre de proceso." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ApplicationCountText" Grid.Column="1" VerticalAlignment="Bottom" Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,18,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ApplicationInput" KeyDown="ApplicationInput_KeyDown" ToolTip="Ejemplo: juego.exe" />
                        <Button Grid.Column="1" Content="Añadir" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="AddApplicationButton_Click" />
                        <Button Grid.Column="2" Content="Examinar…" Margin="8,0,0,0" Click="BrowseApplicationButton_Click" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="ApplicationList" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Value}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" Margin="20,0" />
                                            <Button Grid.Column="2" Style="{StaticResource InlineDeleteButton}" Click="RemoveApplicationItem_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ApplicationEmptyText" Text="Aún no has añadido aplicaciones." Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Horario">
                <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Programación semanal" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox x:Name="ScheduleEnabled" Content="Activar horario" FontWeight="SemiBold" Margin="0,18,0,0" Click="ScheduleControlChanged" />
                    <TextBlock Text="Días activos" Margin="0,22,0,9" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="MondayToggle" Content="Lun" Style="{StaticResource DayToggle}" Click="ScheduleControlChanged" />
                        <ToggleButton x:Name="TuesdayToggle" Content="Mar" Style="{StaticResource DayToggle}" Click="ScheduleControlChanged" />
                        <ToggleButton x:Name="WednesdayToggle" Content="Mié" Style="{StaticResource DayToggle}" Click="ScheduleControlChanged" />
                        <ToggleButton x:Name="ThursdayToggle" Content="Jue" Style="{StaticResource DayToggle}" Click="ScheduleControlChanged" />
                        <ToggleButton x:Name="FridayToggle" Content="Vie" Style="{StaticResource DayToggle}" Click="ScheduleControlChanged" />
                        <ToggleButton x:Name="SaturdayToggle" Content="Sáb" Style="{StaticResource DayToggle}" Click="ScheduleControlChanged" />
                        <ToggleButton x:Name="SundayToggle" Content="Dom" Style="{StaticResource DayToggle}" Click="ScheduleControlChanged" />
                    </StackPanel>
                    <TextBlock Text="Franja horaria" Margin="0,22,0,9" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="StartTimeInput" Width="90" Text="09:00" LostKeyboardFocus="ScheduleTime_LostKeyboardFocus" KeyDown="ScheduleTime_KeyDown" />
                        <TextBlock Text="hasta" VerticalAlignment="Center" Margin="14,0,8,0" />
                        <TextBox x:Name="EndTimeInput" Width="90" Text="17:00" LostKeyboardFocus="ScheduleTime_LostKeyboardFocus" KeyDown="ScheduleTime_KeyDown" />
                    </StackPanel>
                    <TextBlock x:Name="ScheduleSummaryText" Margin="0,20,0,0" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ScheduleValidationText" Margin="0,6,0,0" Foreground="#B42318" TextWrapping="Wrap" />
                    <TextBlock Margin="0,18,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap">
                        El horario se guarda automáticamente. Si la hora final es anterior a la inicial, el bloqueo continuará durante la noche.
                    </TextBlock>
                </StackPanel>
            </TabItem>

            <TabItem Header="Ayuda">
                <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Cómo funciona" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Sitios web" FontWeight="SemiBold" Margin="0,20,0,5" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap">
                        Cold Ham bloquea dominios exactos y sus variantes www mediante el archivo hosts de Windows. No puede filtrar rutas concretas, búsquedas ni todos los subdominios.
                    </TextBlock>
                    <TextBlock Text="Aplicaciones" FontWeight="SemiBold" Margin="0,20,0,5" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap">
                        Cold Ham vigila los procesos configurados mientras la aplicación está abierta. Al iniciar un bloqueo, cualquier aplicación coincidente se cerrará y podría perder trabajo sin guardar.
                    </TextBlock>
                    <TextBlock Text="Permisos" FontWeight="SemiBold" Margin="0,20,0,5" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap">
                        Editar el archivo hosts requiere permisos de administrador. Puedes configurar las reglas sin elevar permisos y reiniciar como administrador al aplicarlas.
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Expander Grid.Row="3" Margin="20,10,20,18" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Expander.Header>
                <TextBlock x:Name="ActivityHeaderText" Text="Actividad" FontWeight="SemiBold" Margin="8,5" />
            </Expander.Header>
            <ListBox x:Name="ActivityList" BorderThickness="0" MaxHeight="150" Margin="8,0,8,8" FontFamily="Consolas" FontSize="12" />
        </Expander>
    </Grid>
</Window>
