<Window x:Class="ColdHam.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cold Ham" Height="740" Width="960" MinHeight="640" MinWidth="800"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,17">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="COLD HAM" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#98A2B3" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusTitleText" Text="{DynamicResource Loading}" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Margin="19,3,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="NextChangeText" Margin="19,2,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="EnforcementText" Margin="19,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                    <Label Content="{DynamicResource Language}" Target="{Binding ElementName=LanguageSelector}" VerticalAlignment="Center" />
                    <ComboBox x:Name="LanguageSelector" Width="110" MinHeight="30" VerticalContentAlignment="Center" IsEnabled="False"
                              SelectedValuePath="Tag" SelectionChanged="LanguageSelector_SelectionChanged"
                              AutomationProperties.Name="{DynamicResource Language}">
                        <ComboBoxItem Content="Español" Tag="es" />
                        <ComboBoxItem Content="English" Tag="en" />
                    </ComboBox>
                </StackPanel>
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" VerticalAlignment="Center">
                    <Button x:Name="Start25Button" Content="25 min" Style="{StaticResource PrimaryButton}" Click="Start25Button_Click" />
                    <Button x:Name="Start50Button" Content="50 min" Style="{StaticResource PrimaryButton}" Click="Start50Button_Click" />
                    <TextBox x:Name="SessionMinutesInput" Width="54" Margin="4,0" ToolTip="{DynamicResource MinutesBetweenAnd}" />
                    <Button x:Name="StartCustomButton" Content="{DynamicResource Start}" Style="{StaticResource PrimaryButton}" Click="StartCustomButton_Click" />
                    <Button x:Name="StartButton" Content="{DynamicResource Unlimited}" Click="StartButton_Click" />
                    <Button x:Name="EndSessionButton" Content="{DynamicResource EndSession}" Click="EndSessionButton_Click" />
                    <Button x:Name="StopButton" Content="{DynamicResource StopAll}" Style="{StaticResource DangerButton}" Click="StopButton_Click" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border x:Name="AdminBanner" Grid.Row="1" Visibility="Collapsed" Background="#FFFAEB"
                BorderBrush="#FEC84B" BorderThickness="0,0,0,1" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource AttentionNeeded}" FontWeight="SemiBold" />
                    <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="RecoveryText" Text=""
                                   Foreground="#7A5A10" Margin="0,2,16,0" TextWrapping="Wrap" />
                    </ScrollViewer>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Retry}" Click="RetryButton_Click" />
                    <Button Content="{DynamicResource RestartAsAdministrator}" Click="ElevateButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" x:Name="MainTabs" Margin="20,16,20,0">
            <TabItem Header="{DynamicResource Overview}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CurrentConfiguration}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="SummaryText" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="SessionSummaryText" Margin="0,7,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Scheduling}" FontWeight="SemiBold" />
                            <TextBlock x:Name="OverviewScheduleText" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Operation}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="{DynamicResource KeepColdHamOpenToBlockApplications}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource WebsitesTab}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource BlockedWebsites}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource AddADomainOrPasteAWeb}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="WebsiteCountText" Grid.Column="1" VerticalAlignment="Bottom" Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,18,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WebsiteInput" KeyDown="WebsiteInput_KeyDown" ToolTip="{DynamicResource ExampleRedditCom}" />
                        <Button Grid.Column="1" Content="{DynamicResource Add}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="AddWebsiteButton_Click" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="WebsiteList" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Value}" FontWeight="SemiBold" />
                                                <TextBlock Text="{DynamicResource DomainAndWwwVariant}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" Margin="20,0" />
                                            <Button Grid.Column="2" Style="{StaticResource InlineDeleteButton}" Click="RemoveWebsiteItem_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="WebsiteEmptyText" Text="{DynamicResource NoWebsitesAddedYet}" Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Allowed}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource AllowedWebsitesAllowlist}" FontSize="18" FontWeight="SemiBold" />
                            <CheckBox x:Name="OnlyAllowedWebsitesToggle" Content="{DynamicResource BlockAllWebsitesExceptTheseChromeAnd}" Margin="0,10,0,0" Click="WebsiteModeChanged" />
                            <TextBlock Text="{DynamicResource DuringASessionOrActiveScheduleOnly}"
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="{DynamicResource RestartChromeEdgeAfterEnablingOrStopping}"
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="AllowedWebsiteCountText" Grid.Column="1" VerticalAlignment="Bottom" Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,18,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AllowedWebsiteInput" KeyDown="AllowedWebsiteInput_KeyDown" ToolTip="{DynamicResource AllowedDomainForExampleExampleCom}" />
                        <Button Grid.Column="1" Content="{DynamicResource Add}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="AddAllowedWebsiteButton_Click" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="AllowedWebsiteList" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" Margin="20,0" />
                                            <Button Grid.Column="2" Style="{StaticResource InlineDeleteButton}" Click="RemoveAllowedWebsiteItem_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="AllowedWebsiteEmptyText" Text="{DynamicResource NoAllowedWebsitesAddedYet}" Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource ApplicationsTab}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource BlockedApplications}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource SelectAnExecutableOrEnterItsProcess}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ApplicationCountText" Grid.Column="1" VerticalAlignment="Bottom" Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,18,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ApplicationInput" KeyDown="ApplicationInput_KeyDown" ToolTip="{DynamicResource ExampleGameExe}" />
                        <Button Grid.Column="1" Content="{DynamicResource Add}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="AddApplicationButton_Click" />
                        <Button Grid.Column="2" Content="{DynamicResource Browse}" Margin="8,0,0,0" Click="BrowseApplicationButton_Click" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="ApplicationList" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Value}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" Margin="20,0" />
                                            <Button Grid.Column="2" Style="{StaticResource InlineDeleteButton}" Click="RemoveApplicationItem_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ApplicationEmptyText" Text="{DynamicResource NoApplicationsAddedYet}" Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Schedule}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource WeeklySchedule}" FontSize="18" FontWeight="SemiBold" />
                        <CheckBox x:Name="ScheduleEnabled" Content="{DynamicResource EnableSchedule}" FontWeight="SemiBold" Margin="0,18,0,0" Click="ScheduleControlChanged" />
                        <TextBlock Text="{DynamicResource ActiveDays}" Margin="0,22,0,9" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="MondayToggle" Content="{DynamicResource Mon}" Style="{StaticResource DayToggle}" Click="ScheduleControlChanged" />
                            <ToggleButton x:Name="TuesdayToggle" Content="{DynamicResource Tue}" Style="{StaticResource DayToggle}" Click="ScheduleControlChanged" />
                            <ToggleButton x:Name="WednesdayToggle" Content="{DynamicResource Wed}" Style="{StaticResource DayToggle}" Click="ScheduleControlChanged" />
                            <ToggleButton x:Name="ThursdayToggle" Content="{DynamicResource Thu}" Style="{StaticResource DayToggle}" Click="ScheduleControlChanged" />
                            <ToggleButton x:Name="FridayToggle" Content="{DynamicResource Fri}" Style="{StaticResource DayToggle}" Click="ScheduleControlChanged" />
                            <ToggleButton x:Name="SaturdayToggle" Content="{DynamicResource Sat}" Style="{StaticResource DayToggle}" Click="ScheduleControlChanged" />
                            <ToggleButton x:Name="SundayToggle" Content="{DynamicResource Sun}" Style="{StaticResource DayToggle}" Click="ScheduleControlChanged" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource TimeRange}" Margin="0,22,0,9" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource From}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="StartTimeInput" Width="90" Text="09:00" LostKeyboardFocus="ScheduleTime_LostKeyboardFocus" KeyDown="ScheduleTime_KeyDown" />
                            <TextBlock Text="{DynamicResource To}" VerticalAlignment="Center" Margin="14,0,8,0" />
                            <TextBox x:Name="EndTimeInput" Width="90" Text="17:00" LostKeyboardFocus="ScheduleTime_LostKeyboardFocus" KeyDown="ScheduleTime_KeyDown" />
                        </StackPanel>
                        <TextBlock x:Name="ScheduleSummaryText" Margin="0,20,0,0" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="ScheduleValidationText" Margin="0,6,0,0" Foreground="#B42318" TextWrapping="Wrap" />
                        <TextBlock Margin="0,18,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="{DynamicResource TheScheduleIsSavedAutomaticallyIfThe}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Help}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource HowItWorks}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource WebsitesTab}" FontWeight="SemiBold" Margin="0,20,0,5" />
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="{DynamicResource ColdHamBlocksExactDomainsAndTheir}" />
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="{DynamicResource InAllowedYouCanEnableAllowedWebsites}" />
                        <TextBlock Text="{DynamicResource ApplicationsTab}" FontWeight="SemiBold" Margin="0,20,0,5" />
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="{DynamicResource ColdHamMonitorsConfiguredProcessesWhileThe}" />
                        <TextBlock Text="{DynamicResource Permissions}" FontWeight="SemiBold" Margin="0,20,0,5" />
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="{DynamicResource EditingTheHostsFileRequiresAdministratorPermissions}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Expander Grid.Row="3" Margin="20,10,20,18" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Expander.Header>
                <TextBlock x:Name="ActivityHeaderText" Text="{DynamicResource Activity}" FontWeight="SemiBold" Margin="8,5" />
            </Expander.Header>
            <ListBox x:Name="ActivityList" BorderThickness="0" MaxHeight="150" Margin="8,0,8,8" FontFamily="Consolas" FontSize="12" />
        </Expander>
    </Grid>
</Window>
