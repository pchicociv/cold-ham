<Window x:Class="ColdHam.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cold Ham" Height="720" Width="940" MinHeight="620" MinWidth="780"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F2F4F7" BorderBrush="#D6DAE1" BorderThickness="1" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Cold Ham" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="Loading…" Margin="0,4,0,0" Foreground="#445166" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Content="Start now" Click="StartButton_Click" />
                    <Button x:Name="StopButton" Content="Stop all" Click="StopButton_Click" />
                    <Button Content="Run as administrator" Click="ElevateButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="MainTabs">
            <TabItem Header="Overview">
                <StackPanel Margin="18" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Block distracting websites and Windows applications" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,16">
                        Add rules in the tabs, then start a block immediately or enable the weekly schedule. Keep Cold Ham open while blocking applications. Website blocking uses the Windows hosts file and requires administrator rights.
                    </TextBlock>
                    <TextBlock Text="Current configuration" FontWeight="SemiBold" Margin="0,6,0,6" />
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
                    <TextBlock Text="Limitations" FontWeight="SemiBold" Margin="0,20,0,6" />
                    <TextBlock TextWrapping="Wrap">
                        Hosts-file blocking covers exact domains and their www variants. It cannot filter a single URL path, browser search, or every possible subdomain. Application blocking is active only while this window is running.
                    </TextBlock>
                </StackPanel>
            </TabItem>

            <TabItem Header="Websites">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Enter a domain or paste a website URL." Margin="4,0,0,8" />
                    <DockPanel Grid.Row="1">
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="Add" Click="AddWebsiteButton_Click" />
                            <TextBox x:Name="WebsiteInput" KeyDown="WebsiteInput_KeyDown" ToolTip="Example: reddit.com" />
                        </DockPanel>
                        <ListBox x:Name="WebsiteList" Margin="4,8,4,4" />
                    </DockPanel>
                    <Button Grid.Row="2" HorizontalAlignment="Left" Content="Remove selected" Click="RemoveWebsiteButton_Click" />
                </Grid>
            </TabItem>

            <TabItem Header="Applications">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Choose an executable or enter a process name such as game.exe." Margin="4,0,0,8" />
                    <DockPanel Grid.Row="1">
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseApplicationButton_Click" />
                            <Button DockPanel.Dock="Right" Content="Add" Click="AddApplicationButton_Click" />
                            <TextBox x:Name="ApplicationInput" KeyDown="ApplicationInput_KeyDown" ToolTip="Example: game.exe" />
                        </DockPanel>
                        <ListBox x:Name="ApplicationList" Margin="4,8,4,4" />
                    </DockPanel>
                    <Button Grid.Row="2" HorizontalAlignment="Left" Content="Remove selected" Click="RemoveApplicationButton_Click" />
                </Grid>
            </TabItem>

            <TabItem Header="Schedule">
                <StackPanel Margin="18">
                    <CheckBox x:Name="ScheduleEnabled" Content="Enable weekly schedule" FontWeight="SemiBold" Checked="ScheduleChanged" Unchecked="ScheduleChanged" />
                    <TextBlock Text="Active days" Margin="5,16,0,5" FontWeight="SemiBold" />
                    <WrapPanel>
                        <CheckBox x:Name="MondayCheck" Content="Mon" />
                        <CheckBox x:Name="TuesdayCheck" Content="Tue" />
                        <CheckBox x:Name="WednesdayCheck" Content="Wed" />
                        <CheckBox x:Name="ThursdayCheck" Content="Thu" />
                        <CheckBox x:Name="FridayCheck" Content="Fri" />
                        <CheckBox x:Name="SaturdayCheck" Content="Sat" />
                        <CheckBox x:Name="SundayCheck" Content="Sun" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <TextBlock Text="From" VerticalAlignment="Center" Margin="5" />
                        <TextBox x:Name="StartTimeInput" Width="80" Text="09:00" />
                        <TextBlock Text="to" VerticalAlignment="Center" Margin="5" />
                        <TextBox x:Name="EndTimeInput" Width="80" Text="17:00" />
                        <Button Content="Save schedule" Click="SaveScheduleButton_Click" />
                    </StackPanel>
                    <TextBlock Margin="5,12,0,0" Foreground="#445166" TextWrapping="Wrap">
                        Use 24-hour times. If the end is earlier than the start, the block continues overnight. Equal start and end times mean the full selected day.
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>

        <GroupBox Grid.Row="2" Header="Activity" Margin="0,12,0,0">
            <ListBox x:Name="ActivityList" BorderThickness="0" FontFamily="Consolas" FontSize="12" />
        </GroupBox>
    </Grid>
</Window>

